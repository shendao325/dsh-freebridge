    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node test/all.mjs",
    "test:ledger": "node test/ledger.test.mjs",
    "test:router": "node test/router.test.mjs",
    "test:guard": "node test/guard.test.mjs",
    "test:desktop": "node test/desktop.test.mjs",
    "test:bootstrap": "node test/bootstrap.test.mjs",
    "test:supervisor": "node test/supervisor.test.mjs",
    "test:integration": "node test/integration.test.mjs",
    "test:host": "node test/host.test.mjs"
